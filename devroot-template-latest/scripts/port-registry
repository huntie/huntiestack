#!/usr/bin/env bash
#
# Allocate dev server ports per project, shared by every devroot on this machine.
#
# Sessions on one machine run dev servers side by side, and every tool defaults
# to the same port: 8081 for Metro, 3000 for most web servers. An allocation
# gives one directory its own port for one kind of server, so servers started
# from different directories never collide. One checkout can hold several such
# directories, such as the apps of a monorepo, and several devroot checkouts
# can share the machine.
#
# Allocations live in one per-user registry,
# ${XDG_STATE_HOME:-~/.local/state}/devroot/port-registry, and last: every
# later call for the same directory and kind prints the same port, from any
# session and any devroot. That matters for Metro, since a native app is
# built against its port, and a moved port means a rebuild or a new
# `adb reverse`. Nothing is released when a session ends; `release` and
# `prune` do that on purpose.
#
# The registry holds one line per allocation, `<kind> <port> <directory>`,
# tab separated, with directories absolute. A `.port-registry` left at a
# devroot root by the earlier per-checkout registry is folded in on first use.
#
# Exit codes: 0 done, 1 error, 2 usage.

set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devroot"
REGISTRY="$STATE_DIR/port-registry"
LOCK="$STATE_DIR/port-registry.lock"
LEGACY="$ROOT/.port-registry"

usage() {
  printf '%s\n' \
    'Usage: scripts/port-registry allocate <metro|web> [<dir>]' \
    '       scripts/port-registry list' \
    '       scripts/port-registry release <metro|web> [<dir>]' \
    '       scripts/port-registry prune' \
    '' \
    'Prints the dev server port allocated to <dir> for that kind of server,' \
    'allocating one on the first call. Start the server from <dir> on that port:' \
    '' \
    '  RCT_METRO_PORT=$(scripts/port-registry allocate metro projects/send-it) npx expo start' \
    '  yarn start --port "$(scripts/port-registry allocate metro projects/react-native/packages/rn-tester)"' \
    '  next dev --port "$(scripts/port-registry allocate web projects/alexhunt.dev)"' \
    '' \
    '  metro     A Metro server, for React Native and Expo apps, React Native DevTools,' \
    '            and Expo web. Ports from 8082; 8081 stays free for servers started' \
    '            without this script.' \
    '  web       Any other web dev server, such as Next, Docusaurus, or Vite. Ports' \
    '            from 3001.' \
    '  <dir>     The directory the server runs from, relative to the root or absolute.' \
    '            Defaults to the current directory, or its nearest parent holding a' \
    '            package.json within the same checkout.' \
    '' \
    '  list      Print every allocation, from every devroot on this machine, and' \
    '            whether something listens on it.' \
    '  release   Drop the allocation for <dir> and that kind. Nothing is stopped.' \
    '  prune     Drop every allocation whose directory no longer exists.' \
    '' \
    'The registry is one per user, shared by every devroot checkout on the machine.' \
    'An allocation lasts: later calls print the same port, and nothing is released' \
    'when a session ends. Only the port goes to stdout. Notes go to stderr:' \
    '' \
    '- When a server started from <dir> is already on the port, it says so. Use' \
    '  that server rather than starting another.' \
    '- When another process holds the port, it prints a free port for this run and' \
    '  keeps the allocation. It never stops the other process.' \
    '' \
    'Exits 0 done, 1 error, 2 usage.'
}

range_start() {
  case "$1" in
    metro) echo 8082 ;;
    web) echo 3001 ;;
  esac
}

# #region probes

# Whether anything accepts connections on the port, over IPv4 or IPv6.
is_listening() {
  (exec 3<> "/dev/tcp/127.0.0.1/$1") 2> /dev/null && return 0
  (exec 3<> "/dev/tcp/::1/$1") 2> /dev/null && return 0
  return 1
}

# The working directory of the process listening on the port, when lsof can
# see it.
listener_cwd() {
  command -v lsof > /dev/null || return 0
  local pid
  pid=$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2> /dev/null | head -n 1 || true)
  [ -n "$pid" ] || return 0
  lsof -a -p "$pid" -d cwd -Fn 2> /dev/null | sed -n 's/^n//p' | head -n 1
}

listener_command() {
  command -v lsof > /dev/null || return 0
  lsof -nP -iTCP:"$1" -sTCP:LISTEN -Fc 2> /dev/null | sed -n 's/^c//p' | head -n 1
}

# The directory a running Metro reports serving, on its /status endpoint.
metro_root() {
  command -v curl > /dev/null || return 0
  curl -s -m 2 -D - -o /dev/null "http://localhost:$1/status" 2> /dev/null |
    tr -d '\r' | sed -n 's/^[Xx]-[Rr]eact-[Nn]ative-[Pp]roject-[Rr]oot: //p' | head -n 1
}

# The nearest directory at or above $1 holding a package.json, stopping at the
# top of its checkout, else $1 itself.
nearest_package_dir() {
  local top d
  top=$(git -C "$1" rev-parse --show-toplevel 2> /dev/null || echo "$1")
  d=$1
  while [ ! -f "$d/package.json" ] && [ "$d" != "$top" ] && [ "$d" != / ]; do
    d=$(dirname "$d")
  done
  if [ -f "$d/package.json" ]; then echo "$d"; else echo "$1"; fi
}

# #endregion
# #region the registry

is_allocated() {
  [ -f "$REGISTRY" ] && awk -F '\t' -v p="$1" '$2 == p { found = 1 } END { exit !found }' "$REGISTRY"
}

lookup() {
  [ -f "$REGISTRY" ] || return 0
  awk -F '\t' -v k="$1" -v d="$2" '$1 == k && $3 == d { print $2; exit }' "$REGISTRY"
}

# The first port from the kind's range that is neither allocated nor in use.
free_port() {
  local port
  port=$(range_start "$1")
  while is_allocated "$port" || is_listening "$port"; do
    port=$((port + 1))
  done
  echo "$port"
}

# Serializes writes, so two sessions allocating at once never pick the same
# port. A lock left by a killed run is taken over after five seconds.
with_lock() {
  local tries=0
  mkdir -p "$STATE_DIR"
  until mkdir "$LOCK" 2> /dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 50 ]; then
      rmdir "$LOCK" 2> /dev/null || true
      tries=0
    fi
    sleep 0.1
  done
  trap 'rmdir "$LOCK" 2> /dev/null || true' EXIT
  "$@"
  rmdir "$LOCK" 2> /dev/null || true
  trap - EXIT
}

# Fold a per-checkout registry into this one. An entry whose port is taken
# here gets a fresh port, which is said aloud since a native build may be
# bound to the old one.
import_legacy() {
  [ -f "$LEGACY" ] || return 0
  local kind port dir new
  while IFS=$'\t' read -r kind port dir; do
    [ -n "$kind" ] && [ -n "$dir" ] || continue
    [ -z "$(lookup "$kind" "$dir")" ] || continue
    if is_allocated "$port"; then
      new=$(free_port "$kind")
      echo "port-registry: $kind port $port for $dir is taken in the shared registry; it is now $new" >&2
      port=$new
    fi
    printf '%s\t%s\t%s\n' "$kind" "$port" "$dir" >> "$REGISTRY"
  done < "$LEGACY"
  rm -f "$LEGACY" "$LEGACY.lock"
  echo "port-registry: folded $LEGACY into $REGISTRY" >&2
}

allocate() {
  local port
  port=$(lookup "$1" "$2")
  if [ -z "$port" ]; then
    port=$(free_port "$1")
    printf '%s\t%s\t%s\n' "$1" "$port" "$2" >> "$REGISTRY"
    echo "port-registry: allocated $1 port $port to $2" >&2
  fi
  echo "$port"
}

release() {
  local port tmp
  port=$(lookup "$1" "$2")
  [ -n "$port" ] || {
    echo "port-registry: no $1 allocation for $2" >&2
    return 1
  }
  tmp=$(mktemp)
  awk -F '\t' -v k="$1" -v d="$2" '!($1 == k && $3 == d)' "$REGISTRY" > "$tmp"
  mv "$tmp" "$REGISTRY"
  echo "port-registry: released $1 port $port from $2" >&2
}

prune() {
  [ -s "$REGISTRY" ] || return 0
  local kind port dir tmp n=0
  tmp=$(mktemp)
  while IFS=$'\t' read -r kind port dir; do
    [ -n "$kind" ] || continue
    if [ -d "$dir" ]; then
      printf '%s\t%s\t%s\n' "$kind" "$port" "$dir" >> "$tmp"
    else
      echo "port-registry: pruned $kind port $port, $dir is gone" >&2
      n=$((n + 1))
    fi
  done < "$REGISTRY"
  mv "$tmp" "$REGISTRY"
  [ "$n" -gt 0 ] || echo "port-registry: nothing to prune" >&2
}

list() {
  [ -s "$REGISTRY" ] || {
    echo "port-registry: no allocations yet" >&2
    return 0
  }
  local kind port dir state
  while IFS=$'\t' read -r kind port dir; do
    [ -n "$kind" ] || continue
    if is_listening "$port"; then
      state="listening: $(listener_command "$port")"
    elif [ ! -d "$dir" ]; then
      state="directory gone"
    else
      state="free"
    fi
    printf '%-6s %-6s %-60s %s\n' "$kind" "$port" "${dir/#$HOME/~}" "$state"
  done < "$REGISTRY"
}

# #endregion

command=""
kind=""
dir_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "port-registry: unknown option '$1'" >&2
      exit 2
      ;;
    *)
      if [ -z "$command" ]; then
        command="$1"
      elif [ -z "$kind" ]; then
        kind="$1"
      elif [ -z "$dir_arg" ]; then
        dir_arg="$1"
      else
        echo "port-registry: too many arguments" >&2
        exit 2
      fi
      ;;
  esac
  shift
done

case "$command" in
  '')
    usage >&2
    exit 2
    ;;
  list | prune)
    [ -z "$kind" ] || {
      echo "port-registry: $command takes no arguments" >&2
      exit 2
    }
    with_lock import_legacy
    [ "$command" = list ] && list || with_lock prune
    exit 0
    ;;
  allocate | release) ;;
  *)
    echo "port-registry: unknown command '$command'; expected allocate, list, release, or prune" >&2
    exit 2
    ;;
esac

case "$kind" in
  metro | web) ;;
  '')
    echo "port-registry: $command needs a kind, metro or web" >&2
    exit 2
    ;;
  *)
    echo "port-registry: unknown kind '$kind'; expected metro or web" >&2
    exit 2
    ;;
esac

if [ -n "$dir_arg" ]; then
  case "$dir_arg" in
    /*) dir="$dir_arg" ;;
    *) dir="$ROOT/$dir_arg" ;;
  esac
  [ -d "$dir" ] || {
    echo "port-registry: no directory $dir" >&2
    exit 1
  }
  dir=$(cd "$dir" && pwd -P)
else
  dir=$(nearest_package_dir "$(pwd -P)")
fi
[ "$dir" != "$ROOT" ] || {
  echo "port-registry: pass the server's directory, e.g. scripts/port-registry $command $kind projects/<name>" >&2
  exit 2
}

with_lock import_legacy

if [ "$command" = release ]; then
  with_lock release "$kind" "$dir"
  exit 0
fi

port=$(with_lock allocate "$kind" "$dir")

if is_listening "$port"; then
  cwd=$(listener_cwd "$port")
  served=""
  [ "$kind" != metro ] || served=$(metro_root "$port")
  if [ "$cwd" = "$dir" ] || [ "${served%/}" = "$dir" ]; then
    echo "port-registry: a server started from $dir is already on $port ($(listener_command "$port")); use it rather than starting another" >&2
  else
    holder=$(listener_command "$port")
    port=$(free_port "$kind")
    echo "port-registry: the allocated port is held by ${holder:-another process}${cwd:+ in $cwd}; use $port for this run" >&2
  fi
fi

echo "$port"
