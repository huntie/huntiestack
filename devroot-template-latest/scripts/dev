#!/usr/bin/env bash
#
# Run a devroot script from anywhere, or print the workspace root.
#
#   dev help                           index of the devroot scripts
#   dev checkout react/react-native    run scripts/checkout
#   dev                                print the workspace root
#   eval "$(dev init)"                 make the last one cd instead, in bash or zsh
#
# Linked by scripts/setup into ~/.local/bin, so it works in any shell with no
# profile changes; dev.fish is the fish function, with cd built in. The root
# is this file's real location, so each devroot links its own copy, and
# $DEVROOT overrides it.
#
# Exit codes: 0 done, 2 usage or unknown name; a script's own otherwise.

set -euo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self=$target ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
ROOT=${DEVROOT:-$(cd "$(dirname "$self")/.." && pwd -P)}

usage() {
  printf '%s\n' \
    'Usage: dev <script> [args...]' \
    '       dev' \
    '       eval "$(dev init)"' \
    '' \
    'Runs scripts/<script> in the devroot this command is linked from, from any' \
    'directory. Alone it prints the workspace root, for cd "$(dev)". In bash or' \
    'zsh, eval "$(dev init)" in the shell profile defines a dev function that cds' \
    'there itself; the fish function does so already.' \
    '' \
    'Exits 0 done, 2 usage or unknown name; a script'\''s own otherwise.'
}

case "${1:-}" in
  '')
    printf '%s\n' "$ROOT"
    exit 0
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  init)
    cat <<'FN'
dev() {
  if [ $# -eq 0 ]; then
    cd "$(command dev)" || return
  else
    command dev "$@"
  fi
}
FN
    exit 0
    ;;
  -*)
    usage >&2
    exit 2
    ;;
esac

script="$ROOT/scripts/$1"
if [ -x "$script" ]; then
  shift
  exec "$script" "$@"
fi

names=
for f in "$ROOT"/scripts/*; do
  [ -x "$f" ] && names="$names ${f##*/}"
done
echo "dev: no script '$1' in $ROOT" >&2
echo "     scripts:$names" >&2
exit 2
