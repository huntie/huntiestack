# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[scripts/*]
indent_style = space
binary_next_line = true
switch_case_indent = true
space_redirects = true
